# EM dev-stack — shared environment. Copy to `.env` IN THIS dev-stack/ directory
# and edit if needed:   cp .env.example .env
#
# docker compose (via up.sh) auto-reads this .env. To point em-bridge / EMStudio
# at the local S3 store (RustFS), ALSO load it into your shell before starting em-bridge:
#     set -a; . EMStudio/dev-stack/.env; set +a
#
# The S3_* names match s3dgraphy's S3Config.from_env() AND Heriverse-Server,
# so all tools read/write the SAME bucket + prefix (one object keyspace).

# ── S3 object store (RustFS) ──────────────────────────────────────────────────
# S3_ENDPOINT is HOST-facing (em-bridge runs on the host). Inside the compose
# network, services use http://rustfs:9000 (handled in docker-compose.dev.yml).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=heriverse
S3_PREFIX=heriverse
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=password
# host ports the dev compose publishes (API / console at /rustfs/console/)
S3_PORT=9000
S3_CONSOLE_PORT=9001

# ── Keycloak + Postgres (only used by `up.sh dev auth` / compose profile auth) ──
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak
