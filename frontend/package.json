{
  "name": "emstudio-frontend",
  "private": true,
  "version": "1.6.0-dev.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "vite preview --host",
    "set-version": "node ../scripts/set-version.mjs",
    "build:all": "npm run build && npm run build:reader",
    "build:reader": "EM_ENTRY=reader vite build"
  },
  "devDependencies": {
    "linkedom": "^0.18.13",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.3"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@types/three": "^0.185.4",
    "three": "^0.185.1"
  }
}
