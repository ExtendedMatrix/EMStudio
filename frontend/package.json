{
  "name": "emstudio-frontend",
  "private": true,
  "version": "1.6.0-dev.159",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "vite preview --host",
    "set-version": "node ../scripts/set-version.mjs",
    "build:all": "npm run build && npm run build:reader",
    "build:reader": "EM_ENTRY=reader vite build",
    "build:lab": "tsc --noEmit && EM_PROFILE=lab vite build",
    "build:engine3d": "EM_ENTRY=engine3d vite build",
    "build:web": "EM_LAZY_3D=1 npm run build && npm run build:engine3d && npm run build:tiles3d && npm run build:splat3d && npm run build:reader",
    "build:tiles3d": "EM_ENTRY=tiles3d vite build",
    "build:splat3d": "EM_ENTRY=splat3d vite build",
    "check:datamodel": "node scripts/check-datamodel.mjs",
    "check:emjson": "node scripts/check-emjson-conformance.mjs"
  },
  "devDependencies": {
    "linkedom": "^0.18.13",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.3"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "~2.5.5",
    "@types/three": "0.187.0",
    "3d-tiles-renderer": "0.5.3",
    "3d-tiles-renderer-3tz": "github:zalmoxes-laran/3d-tiles-renderer-3tz#4cc4536ff68892fe2d717feee8671054a51778b0",
    "3d-tiles-rendererjs-3dgs-plugin": "0.3.1",
    "gaussian-splat-lite": "1.11.0",
    "three": "0.187.0"
  }
}
